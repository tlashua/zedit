<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Package-specific logging configuration -->
    <logger name="net.lashua" level="DEBUG"/>
<!--    <logger name="net.lashua.zonedit.ui" level="TRACE"/>-->
<!--    <logger name="net.lashua.zonedit.model" level="INFO"/>-->

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
